  "info": {
    "_postman_id": "804ac42b-2cab-4a69-999f-3f80266c30cc",
    "name": "Cloud Native Registry Buildpacks API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Buildpack Registry API serves the registry-index for the Cloud Native Buildpacks community registry. It exposes endpoints for searching the registry by keyword and for retrieving namespaced buildpack version metadata. The registry is backed by the `buildpacks/registry-index` GitHub repository and is consumed by the `pack` CLI (`pack buildpack pull/register/yank`) and by buildpack authors who publish to the public CNB registry.\n\n\nContact Support:\n Name: Cloud Native Buildpacks",
      "type": "text/plain"
    }
